NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (libSQL / Turso).
# Local dev & tests use a local SQLite file via DATABASE_PATH (below).
# For production (Vercel), create a Turso database and set:
#   DATABASE_URL=libsql://your-db-name-org.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
# Development and tests always use DATABASE_PATH. Production requires both
# Turso variables and ignores DATABASE_PATH.
DATABASE_PATH=./data/bizflow.db
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# SMS provider: mock|smpp|movider|twilio|infobip|clicksend
# mock logs "[SMS MOCK] To: ..." to the console and always succeeds; use it
# for local dev. Leave unset to default to mock.
SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=BizFlow

# SMPP (direct SMSC / local Philippine SMS aggregator). Used when SMS_PROVIDER=smpp.
# SMS_PROVIDER=smpp
# SMPP_HOST=smsc.example.com
# SMPP_PORT=2775
# SMPP_SYSTEM_ID=your_smpp_system_id
# SMPP_PASSWORD=your_smpp_password
# SMPP_BIND_TYPE=transceiver          # transceiver | transmitter
# Registered sender IDs. A per-carrier match is used when set; otherwise the default.
# SMPP_SOURCE_ADDR=BizFlow            # default sender (falls back to SMS_SENDER_ID)
# SMPP_SOURCE_ADDR_SMART=your_smart_sender_id
# SMPP_SOURCE_ADDR_GLOBE=your_globe_sender_id
# Address TON/NPI. Defaults suit alphanumeric sender + international MSISDN.
# SMPP_SOURCE_ADDR_TON=5
# SMPP_SOURCE_ADDR_NPI=0
# SMPP_DEST_ADDR_TON=1
# SMPP_DEST_ADDR_NPI=1
# SMPP_REGISTERED_DELIVERY=1          # 1 = request delivery receipts (DLR)
# Optional tuning (milliseconds) and diagnostics. The defaults are sized to fit
# inside the SMS routes' `maxDuration = 30` on serverless: a cold instance pays
# the SMPP bind inside the request, and anything longer than the function budget
# is killed mid-send and surfaces as an opaque 504 rather than an SMPP error.
# Raise these only alongside maxDuration in the routes.
# SMPP_BIND_TIMEOUT_MS=12000          # covers connect + bind
# SMPP_CONNECT_TIMEOUT_MS=12000
# SMPP_SUBMIT_TIMEOUT_MS=8000         # per message part
# SMPP_ENQUIRE_LINK_MS=10000
# SMPP_DEBUG=false

# How long the "Confirm & Reserve" response waits on the SMS provider before
# returning anyway. The voucher is already committed at that point, so this only
# caps how long the visitor waits on delivery; a slow send continues in the
# background and is logged in sms_logs either way.
# SMS_RESPONSE_BUDGET_MS=4000

# Movider (Philippines) -- https://developer.movider.co
# SMS_PROVIDER=movider
# SMS_API_KEY=your_movider_api_key
# SMS_API_SECRET=your_movider_api_secret
# SMS_SENDER_ID=BizFlow

# Twilio
# SMS_PROVIDER=twilio
# SMS_API_KEY=your_twilio_account_sid
# SMS_API_SECRET=your_twilio_auth_token
# SMS_SENDER_ID=+1234567890

# Infobip
# SMS_PROVIDER=infobip
# SMS_API_KEY=your_infobip_api_key
# INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
# SMS_SENDER_ID=BizFlow

# ClickSend
# SMS_PROVIDER=clicksend
# SMS_API_KEY=your_clicksend_username
# SMS_API_SECRET=your_clicksend_api_key
# SMS_SENDER_ID=BizFlow

# Dashboard login. Replace every example value before deployment.
ADMIN_NAME=BizFlow Admin
ADMIN_EMAIL=admin@bizflow.local
ADMIN_PASSWORD=change-this-admin-password
# Generate a long random value (at least 32 characters). Changing it logs out
# every active admin session.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional server-only bearer token for trusted scripts/integrations.
# Never expose this value through a NEXT_PUBLIC_ variable.
ADMIN_ACCESS_TOKEN=local-admin-integration-token
# Destructive demo-data reset stays disabled in production unless explicitly enabled.
ALLOW_DASHBOARD_RESET=false

# Optional business-scoped staff login (exactly one business ID per account).
STAFF_NAME=Campaign Staff
STAFF_EMAIL=staff@bizflow.local
STAFF_PASSWORD=change-this-staff-password
STAFF_BUSINESS_IDS=biz_demo_restaurant

# Optional salt for hashing OTP codes at rest (defaults to ADMIN_ACCESS_TOKEN).
# OTP_SALT=replace-with-random-value
# Optional salt for hashing IPs in the rate-limit table (defaults to ADMIN_ACCESS_TOKEN).
# RATE_LIMIT_SALT=replace-with-random-value

# --- Google Play review account ---------------------------------------------
# Lets one number sign in with a fixed code instead of an SMS, because Play's
# reviewers cannot receive the OTP. Both must be set or the bypass stays inert;
# the code must be exactly 6 digits. Use a RANDOM code, not 000000 — it is
# long-lived, and only the per-IP rate limit stands between it and a guesser.
# Must match what is entered under Play Console > App content > App access.
# UNSET BOTH once the app is live. See docs/PLAY_CONSOLE_ANSWERS.md §2.
# REVIEW_ACCOUNT_PHONE=09171234567
# REVIEW_ACCOUNT_OTP=replace-with-random-6-digits

# --- Push notifications -----------------------------------------------------
# Shared secret for POST/GET /api/cron/notifications. The route refuses to run
# when this is unset, so an unconfigured deploy cannot be triggered publicly.
# Send it as `Authorization: Bearer <secret>` or `?secret=<secret>`.
# CRON_SECRET=replace-with-random-value
# Optional. Only needed if the Expo project enforces push security; unset works
# for the default setup, where Expo relays to FCM on our behalf.
# EXPO_ACCESS_TOKEN=
# Optional. How long to wait on Expo's push endpoint before logging a failure.
# PUSH_TIMEOUT_MS=8000

# --- Android App Links ------------------------------------------------------
# Served at /.well-known/assetlinks.json so Android verifies deep links and
# opens them in the app instead of showing a chooser.
# Use the *Play App Signing* SHA-256, not the upload key: Play re-signs the AAB.
# Play Console -> Release -> Setup -> App signing -> App signing key certificate.
# Comma-separate to also verify a local debug build.
# ANDROID_PACKAGE_NAME=com.voucherhunt.mobile
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
