# Android emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# For a physical device, use the development computer's LAN IP instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Production must use the stable HTTPS deployment:
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.example

# Required by Android development/store builds for the embedded Google map.
# Enable Maps SDK for Android, then restrict this key to package
# com.voucherhunt.mobile and the applicable signing-certificate SHA-1.
# GOOGLE_MAPS_API_KEY=your_restricted_android_maps_key
